{
  "name": "@ahomeyonglin/ui",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "registry.json",
    "AGENTS.md"
  ],
  "exports": {
    "./Badge": {
      "types": "./dist/components/Badge/Badge.d.ts",
      "default": "./dist/components/Badge/Badge.js"
    },
    "./Button": {
      "types": "./dist/components/Button/Button.d.ts",
      "default": "./dist/components/Button/Button.js"
    },
    "./Card": {
      "types": "./dist/components/Card/Card.d.ts",
      "default": "./dist/components/Card/Card.js"
    },
    "./Text": {
      "types": "./dist/components/Text/Text.d.ts",
      "default": "./dist/components/Text/Text.js"
    },
    "./TextField": {
      "types": "./dist/components/TextField/TextField.d.ts",
      "default": "./dist/components/TextField/TextField.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahomeyonglin/design-system.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "build:registry": "node scripts/build-registry.mjs",
    "lint": "node scripts/lint-components.mjs",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
